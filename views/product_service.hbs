<style>
    .static-body {
        border-radius: 6px;
        box-shadow: 2px 2px 4px #00000020;
        transition: all 200ms ease-out;
    }

    .static-body:hover {
        box-shadow: 4px 4px 8px #00000040;
        transition: all 200ms ease-out;
        background-color: #FFFFFF90 !important;
    }

    .image-container {
        position: relative;
        display: inline-block;
        width: 120px;
        height: 120px;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 5px;
    }

    .image-container .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .image-container:hover .image-overlay {
        opacity: 1;
    }

    .no-image-container {
        position: relative;
        display: inline-block;
        width: 120px;
        height: 120px;
        background-color: #f5f5f5;
        border: 2px dashed #ddd;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .no-image-container .upload-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 123, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .no-image-container:hover .upload-overlay {
        opacity: 1;
    }

    .no-image-container .default-icon {
        font-size: 32px;
        color: #ccc;
    }
</style>

<div class="row my-3 p-10 bg-white border rounded">
    <div>
        <h3>Product & Service List</h3>
    </div>
    <div class="col-12 mb-4 d-flex justify-content-between align-items-center my-5">
        <div class="d-flex justify-content-between gap-3 align-items-center w-100">
            <div class="input-group" style="width: 250px;">
                <input type="text" class="form-control" id="product_service_search_input" placeholder="Search...">
            </div>
            <button type="button" class="btn btn-primary" id="add_product_service_btn">
                <i class="fas fa-plus"></i> Add New
            </button>
        </div>
    </div>
    <div class="col-12">
        <div class="table-responsive">
            <table class="table" id="product_service_tb">
                <thead>
                    <th>Image</th>
                    <th>Category</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Cycle</th>
                    <th>Type</th>
                    <th>Billing Type</th>
                    <th>Date Created</th>
                    <th>Status</th>
                    <th>Actions</th>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

{{!-- Upload Image Modal --}}
<div class="modal fade" id="upload_image_modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Product Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="upload_image_form" enctype="multipart/form-data">
                    <input type="hidden" id="upload_product_id" name="product_id">
                    
                    <div class="form-group">
                        <label>Select Image (Max 320×320px)</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="product_image_input" name="image" accept="image/*" required>
                            <label class="custom-file-label" for="product_image_input">Choose image...</label>
                        </div>
                        <small class="form-text text-muted">Recommended size: 320×320 pixels</small>
                        
                        <small id="upload_size_warning" class="form-text text-danger" style="display: none;">
                            <i class="fas fa-exclamation-circle"></i> 
                            <span id="upload_warning_message"></span>
                        </small>
                        <small id="upload_size_success" class="form-text text-success" style="display: none;">
                            <i class="fas fa-check-circle"></i> 
                            <span id="upload_success_message"></span>
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="upload_image_btn">Upload</button>
            </div>
        </div>
    </div>
</div>

{{!-- Add/Edit Modal --}}
<div class="modal fade" id="product_service_modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_title">Add Product/Service</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="product_service_form">
                    <input type="hidden" id="product_service_id" name="id">
                    {{!-- Category --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Category <span class="text-danger">*</span></label>
                        <div class="col-lg-9">
                            <select class="form-control" id="category_id" name="category_id" required>
                            </select>
                        </div>
                    </div>
                    {{!-- Category --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Name <span class="text-danger">*</span></label>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="name" name="name" placeholder="Product/Service Name" required>
                        </div>
                    </div>
                    {{!-- Description --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Description</label>
                        <div class="col-lg-9">
                            <div class="summernote" id="description"></div>
                        </div>
                    </div>
                    {{!-- Price --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Price <span class="text-danger">*</span></label>
                        <div class="col-lg-9">
                            <input type="number" step="0.01" class="form-control" id="price" name="price" placeholder="0.00" required>
                        </div>
                    </div>
                    {{!-- Billing Type --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Billing Type <span class="text-danger">*</span></label>
                        <div class="col-lg-9">
                            <select class="form-control" id="billing_type" name="billing_type" required>
                                <option value="one_time">One Time</option>
                                <option value="recurring">Recurring</option>
                                <option value="usage_based">Usage Based</option>
                            </select>
                        </div>
                    </div>
                    {{!-- Recurring Interval --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Recurring Interval</label>
                        <div class="col-lg-9">
                            <select class="form-control" id="recurring_interval" name="recurring_interval">
                                <option value="none">None</option>
                                <option value="monthly">Monthly</option>
                                <option value="quarterly">Quarterly</option>
                                <option value="semi_annual">Semi-Annual</option>
                                <option value="annual">Annual</option>
                            </select>
                        </div>
                    </div>
                    {{!-- Stock Quantity --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Stock Quantity</label>
                        <div class="col-lg-9">
                            <input type="number" class="form-control" id="stock_quantity" name="stock_quantity" placeholder="0">
                        </div>
                    </div>
                    {{!-- Usage Limit --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Usage Limit</label>
                        <div class="col-lg-9">
                            <input type="number" class="form-control" id="usage_limit" name="usage_limit" placeholder="0">
                        </div>
                    </div>
                    {{!-- Status --}}
                    <div class="form-group row">
                        <label class="col-lg-3 col-form-label">Status <span class="text-danger">*</span></label>
                        <div class="col-lg-9">
                            <select class="form-control" id="status" name="status" required>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="save_product_service_btn">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#description').summernote({
            tabsize: 1,
            height: 150
        });
        
        // Load categories
        $.ajax({
            url: '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/read-categories',
            method: 'POST',
            dataType: 'json',
            success: function(response) {
                if (response.data && response.data.length > 0) {
                    response.data.forEach(function(category) {
                        $('#category_id').append(`<option value="${category.id}">${category.name}</option>`);
                    });
                }
            },
            error: function() {
                toastr.error('Failed to load categories');
            }
        });

        let productServiceTable = $('#product_service_tb').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            "searching": true,
            "dom": 'lrtip', // Remove default search box
            "ajax": {
                "url": "{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/read",
                "type": "POST",
                "dataSrc": "data"
            },
            "columns": [
                {
                    data: 'image_url',
                    render: function(data, type, row) {
                        if (!row.image_url) {
                            return `<div class="no-image-container" idkey="${row.id}">
                                        <i class="fas fa-image default-icon"></i>
                                        <div class="upload-overlay">
                                            <span class="btn btn-icon btn-sm btn-light-success product_service_image_upload_btn" title="Upload Image" idkey="${row.id}">
                                                <i class="fas fa-upload"></i>
                                            </span>
                                        </div>
                                    </div>`;
                        }
                        return `<div class="image-container" idkey="${row.id}">
                                    <img src="{{env.HOST_URL}}{{env.PREFIX_URL}}/assets/images/product_service/${row.image_url}" alt="PI" />
                                    <div class="image-overlay">
                                        <span class="btn btn-icon btn-sm btn-light-danger product_service_image_delete_btn" title="Delete Image" idkey="${row.id}">
                                            <i class="fas fa-trash"></i>
                                        </span>
                                    </div>
                                </div>`;
                    }
                },
                { 
                    data: 'product_category',
                    render: function(data, type, row) {
                        return data ? data.name : 'N/A';
                    }
                },
                { data: 'name' },
                { 
                    data: 'price',
                    render: function(data, type, row) {
                        return '$' + parseFloat(data).toFixed(2);
                    }
                },
                {
                    data: 'recurring_interval',
                    render: function(data, type, row) {
                        return data.toUpperCase();
                    }
                },
                {
                    data: 'product_category',
                    render: function(data, type, row) {
                        return data.type === 'product' ? 'Product' : 'Service';
                    }
                },
                { 
                    data: 'billing_type',
                    render: function(data, type, row) {
                        return data === 'one_time' ? 'One Time' : 'Recurring';
                    }
                },
                {
                    data: "createdAt",
                    render: function(data, type, row) {
                        return new Date(data).toLocaleDateString();
                    }
                },
                { 
                    data: 'status',
                    render: function(data, type, row) {
                        const statusClass = data == 1 ? 'success' : 'danger';
                        const statusText = data == 1 ? 'Active' : 'Inactive';
                        return `<span class="badge badge-${statusClass}">${statusText}</span>`;
                    }
                },
                { 
                    data: 'id',
                    render: function(data, type, row) {
                        return `<div idkey="${data}">
                                    <span class="btn btn-icon btn-sm btn-light-primary product_service_edit_btn" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </span>
                                    <span class="btn btn-icon btn-sm btn-light-danger product_service_delete_btn" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </span>
                                </div>`;
                    }
                }
            ]
        });

        // Custom search input
        $('#product_service_search_input').on('keyup', function() {
            productServiceTable.search(this.value).draw();
        });

        // Upload image button click
        $(document).on('click', '.product_service_image_upload_btn', function() {
            const productId = $(this).attr('idkey');
            $('#upload_product_id').val(productId);
            $('#upload_image_form')[0].reset();
            $('#product_image_input').next('.custom-file-label').text('Choose image...');
            $('#upload_size_warning').hide();
            $('#upload_size_success').hide();
            $('#upload_image_modal').modal('show');
        });

        // Image validation for upload
        $('#product_image_input').on('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                $(this).next('.custom-file-label').text(file.name);
                
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        if (img.width > 320 || img.height > 320) {
                            $('#upload_warning_message').text(
                                `Image size is ${img.width}×${img.height}px - exceeds maximum 320×320px`
                            );
                            $('#upload_size_warning').show();
                            $('#upload_size_success').hide();
                        } else {
                            $('#upload_success_message').text(
                                `Perfect! Image size is ${img.width}×${img.height}px`
                            );
                            $('#upload_size_success').show();
                            $('#upload_size_warning').hide();
                        }
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Upload image submit
        $('#upload_image_btn').on('click', function() {
            const image = $('#product_image_input')[0];
            if (image.files.length === 0) {
                toastr.error('Please select an image');
                return;
            }
            const formData = new FormData();
            formData.append('image', image.files[0]);
            formData.append('id', $('#upload_product_id').val());

            $.ajax({
                url: '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/upload-image',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'success') {
                        toastr.success('Image uploaded successfully!');
                        $('#upload_image_modal').modal('hide');
                        productServiceTable.ajax.reload();
                    } else {
                        toastr.error(response.message || 'Upload failed');
                    }
                },
                error: function(xhr) {
                    toastr.error('An error occurred. Please try again.');
                }
            });
        });

        // Delete image button click
        $(document).on('click', '.product_service_image_delete_btn', function() {
            const productId = $(this).attr('idkey');
            
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this image?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/delete-image',
                        method: 'POST',
                        data: { id: productId },
                        dataType: 'json',
                        success: function(response) {
                            if (response.status === 'success') {
                                toastr.success('Image deleted successfully!');
                                productServiceTable.ajax.reload();
                            } else {
                                toastr.error(response.message || 'Delete failed');
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred. Please try again.');
                        }
                    });
                }
            });
        });

        // Add new button click
        $('#add_product_service_btn').on('click', function() {
            $('#modal_title').text('Add Product/Service');
            $('#product_service_form')[0].reset();
            $('#product_service_id').val('');
            $('#product_service_modal').modal('show');
        });

        // Edit button click
        $(document).on('click', '.product_service_edit_btn', function() {
            const id = $(this).parent().attr('idkey');

            $.ajax({
                url: '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/chosen',
                method: 'POST',
                dataType: 'json',
                data: { id: id },
                success: function(response) {
                    const result = response.data
                    
                    $('#modal_title').text('Edit Product/Service');
                    $('#product_service_id').val(result.id);
                    $('#name').val(result.name);
                    $('#description').summernote("code", result.description);
                    $('#price').val(result.price);
                    $('#billing_type').val(result.billing_type);
                    $('#recurring_interval').val(result.recurring_interval);
                    $('#stock_quantity').val(result.stock_quantity);
                    $('#usage_limit').val(result.usage_limit);
                    $('#status').val(result.status);
                    $('#category_id').val(result.category_id);
                    
                    $('#product_service_modal').modal('show');
                },
                error: function() {
                    toastr.error('Failed in server');
                }
            })
        });

        // Save button click
        $('#save_product_service_btn').on('click', function() {
            const form = $('#product_service_form')[0];
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const id = $('#product_service_id').val();
            const url = id ? 
                '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/update' : 
                '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/create';

            const formData = {
                id: id,
                category_id: $('#category_id').val(),
                name: $('#name').val(),
                description: $('#description').summernote("code"),
                price: $('#price').val(),
                billing_type: $('#billing_type').val(),
                recurring_interval: $('#recurring_interval').val(),
                stock_quantity: $('#stock_quantity').val() || 0,
                usage_limit: $('#usage_limit').val() || 0,
                status: $('#status').val()
            };

            $.ajax({
                url: url,
                method: 'POST',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'success') {
                        toastr.success(id ? 'Product/Service updated successfully!' : 'Product/Service created successfully!');
                        $('#product_service_modal').modal('hide');
                        productServiceTable.ajax.reload();
                    } else {
                        toastr.error(response.message || 'Operation failed');
                    }
                },
                error: function(xhr) {
                    toastr.error('An error occurred. Please try again.');
                }
            });
        });

        // Delete button click
        $(document).on('click', '.product_service_delete_btn', function() {
            const id = $(this).parent().attr('idkey');
            
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '{{env.HOST_URL}}{{env.PREFIX_URL}}/product_service/delete',
                        method: 'POST',
                        data: { id: id },
                        dataType: 'json',
                        success: function(response) {
                            if (response.status === 'success') {
                                toastr.success('Product/Service deleted successfully!');
                                productServiceTable.ajax.reload();
                            } else {
                                toastr.error(response.message || 'Delete failed');
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred. Please try again.');
                        }
                    });
                }
            });
        });
        
    });
</script>
